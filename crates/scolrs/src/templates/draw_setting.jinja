<details>
    <summary>Settings</summary>
    <div class="controls">
        <div class="control-group">
            <label for="lineWidth">Line Width:</label>
            <input type="range" id="lineWidth" min="0" max="100" value="10">
            <span class="value-display" id="lineWidthValue">1px</span>
        </div>

        <div class="control-group">
            <label for="fontSize">Font Size:</label>
            <input type="range" id="fontSize" min="0" max="48" value="24">
            <span class="value-display" id="fontSizeValue">24px</span>
        </div>

        <div class="control-group">
            <label for="radius">Radius:</label>
            <input type="range" id="radius" min="0" max="100" value="20">
            <span class="value-display" id="radiusValue">2px</span>
        </div>

        <div class="control-group">
            <label for="opacity">Opacity:</label>
            <input type="range" id="opacity" min="0" max="100" value="100">
            <span class="value-display" id="opacityValue">100%</span>
        </div>
    </div>
</details>